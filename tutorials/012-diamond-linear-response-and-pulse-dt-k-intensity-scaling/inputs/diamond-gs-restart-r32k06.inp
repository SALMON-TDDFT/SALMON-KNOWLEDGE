! Diamond ground state that writes the restart data the response and pulse runs read (SALMON v2.3.0).
! Primitive 2-atom fcc cell, FHI98PP LDA, xc = 'PZ', nelec = 8, nstate = 8, fixed occupations, no symmetry.
! num_rgrid = 32^3 and num_kgrid = 6^3 are the values of the response and pulse runs of the tutorial.
! Same physics as the ground-state tutorial SALMON-TUTORIAL-010; only write_gs_restart_data differs.
! Run in a directory that holds ./06-C.LDA.fhi (ABINIT LDA_FHI 06-C.LDA.fhi).
! The restart data are written to ./data_for_restart/ (info.bin, occupation.bin, rho_inout.bin, wfn.bin).
&calculation
  theory = 'dft'
/

&control
  sysname = 'diamond_gsr_r32k06'
  write_gs_restart_data = 'all'
/

&parallel
  process_allocation = 'orbital_sequential'
  ! 6 nodes x 4 MPI processes = 24; nproc_k must divide the number of k points (216)
  nproc_k  = 24
  nproc_ob = 1
  nproc_rgrid = 1, 1, 1
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  ! primitive fcc vectors, a = 3.567 Angstrom, h = a/2
  al_vec1 = 0.0d0, 1.7835d0, 1.7835d0
  al_vec2 = 1.7835d0, 0.0d0, 1.7835d0
  al_vec3 = 1.7835d0, 1.7835d0, 0.0d0
  nstate = 8
  nelec  = 8
  nelem  = 1
  natom  = 2
  yn_symmetry = 'n'
/

&pseudo
  izatom(1) = 6
  file_pseudo(1) = './06-C.LDA.fhi'
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 32, 32, 32
/

&kgrid
  ! n x n x n on the reciprocal primitive axes: SALMON's half-shifted Monkhorst-Pack mesh
  ! (no Gamma point for even n), no symmetry reduction
  num_kgrid = 6, 6, 6
/

&scf
  ncg = 4
  nscf = 800
  threshold = 1d-9
  method_mixing = 'broyden'
/

&analysis
  yn_out_dos = 'y'
  ! temperature_k is not set (fixed occupations): the energy origin is the valence-band maximum
  ! of the k mesh.
  yn_out_dos_set_fe_origin = 'y'
  out_dos_start = -24.0d0
  out_dos_end = 10.0d0
  out_dos_nenergy = 2721
  out_dos_width = 0.1d0
  out_dos_function = 'gaussian'
/

&atomic_red_coor
  'C' 0.05d0 0.05d0 0.05d0 1
  'C' 0.30d0 0.30d0 0.30d0 1
/

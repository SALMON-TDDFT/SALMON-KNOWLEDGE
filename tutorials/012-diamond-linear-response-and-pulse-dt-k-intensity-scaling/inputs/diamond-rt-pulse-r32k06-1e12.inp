! Diamond real-time pulse (theory = 'tddft_pulse'), SALMON v2.3.0. Peak intensity 1e12 W/cm^2.
! Primitive 2-atom fcc cell, FHI98PP LDA, xc = 'PZ', nstate = 8, 32^3 grid, 6^3 k mesh (the ground-state mesh).
! dt = 5.2e-5 fs = 50 % of the estimated stability limit of the 4th-order Taylor propagator at this grid
! (1.04e-4 fs); nt = 384700 -> 20.0044 fs (pulse length tw1 = 10.672 fs plus about 9 fs of ringdown).
! The 1e11 and 1e13 W/cm^2 runs differ from this deck only in I_wcm2_1. Based on the official sample
! exercise_06_bulkSi_rt.
! Run in a directory that holds ./06-C.LDA.fhi and ./restart/ . ./restart/ must contain info.bin,
! occupation.bin, rho_inout.bin and wfn.bin of the matching ground-state run (same grid, k mesh, nstate),
! copied or linked from that run's data_for_restart/. The executed run read the ground state through a
! relative path to the neighbouring run directory; use a short relative path (SALMON stores it in a
! 100-character string, so a long absolute path is truncated).
&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'diamond_rt_I12'
  yn_restart = 'n'
  directory_read_data = './restart/'
/

&parallel
  process_allocation = 'orbital_sequential'
  ! 9 nodes x 4 MPI processes = 36 (6 k points per process); nproc_k must divide the number of k points (216)
  nproc_k  = 36
  nproc_ob = 1
  nproc_rgrid = 1, 1, 1
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al_vec1 = 0.0d0, 1.7835d0, 1.7835d0
  al_vec2 = 1.7835d0, 0.0d0, 1.7835d0
  al_vec3 = 1.7835d0, 1.7835d0, 0.0d0
  nstate = 8
  nelec  = 8
  nelem  = 1
  natom  = 2
  yn_symmetry = 'n'
/

&pseudo
  izatom(1) = 6
  file_pseudo(1) = './06-C.LDA.fhi'
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 32, 32, 32
/

&kgrid
  num_kgrid = 6, 6, 6
/

&tgrid
  dt = 5.2d-5
  nt = 384700
/

&emfield
  ! cos^2 envelope of the vector potential, as in the official sample
  ae_shape1 = 'Acos2'
  ! peak intensity (W/cm^2)
  I_wcm2_1 = 1.0d12
  ! pulse length (fs) and mean photon energy (eV)
  tw1 = 10.672d0
  omega1 = 1.55d0
  epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
/

&analysis
  de      = 0.01d0
  nenergy = 3000
  ! number of excited electrons and holes by projection on the ground-state orbitals, written 100 times
  ! (each projection runs a CG iteration until |dE_kin| < threshold_projection)
  projection_option = 'gs'
  out_projection_step = 3847
/

&atomic_red_coor
  'C' 0.05d0 0.05d0 0.05d0 1
  'C' 0.30d0 0.30d0 0.30d0 1
/

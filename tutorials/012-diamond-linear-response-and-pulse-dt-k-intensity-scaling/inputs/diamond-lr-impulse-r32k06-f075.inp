! Diamond linear response from an impulse (theory = 'tddft_response'), SALMON v2.3.0.
! Primitive 2-atom fcc cell, FHI98PP LDA, xc = 'PZ', nstate = 8, 32^3 grid, 6^3 k mesh (the ground-state mesh).
! dt = 7.8e-5 fs = 75 % of the estimated stability limit of the 4th-order Taylor propagator at this grid
! (1.04e-4 fs); nt = 641100 -> 50.0058 fs. Based on the official sample exercise_05_bulkSi_lr.
! Run in a directory that holds ./06-C.LDA.fhi and ./restart/ . ./restart/ must contain info.bin,
! occupation.bin, rho_inout.bin and wfn.bin of the matching ground-state run (same grid, k mesh, nstate),
! copied or linked from that run's data_for_restart/. The executed run read the ground state through a
! relative path to the neighbouring run directory; use a short relative path (SALMON stores it in a
! 100-character string, so a long absolute path is truncated).
&calculation
  theory = 'tddft_response'
/

&control
  sysname = 'diamond_lr_r32k06'
  yn_restart = 'n'
  directory_read_data = './restart/'
/

&parallel
  process_allocation = 'orbital_sequential'
  ! 18 nodes x 4 MPI processes = 72 (3 k points per process); nproc_k must divide the number of k points (216)
  nproc_k  = 72
  nproc_ob = 1
  nproc_rgrid = 1, 1, 1
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al_vec1 = 0.0d0, 1.7835d0, 1.7835d0
  al_vec2 = 1.7835d0, 0.0d0, 1.7835d0
  al_vec3 = 1.7835d0, 1.7835d0, 0.0d0
  nstate = 8
  nelec  = 8
  nelem  = 1
  natom  = 2
  yn_symmetry = 'n'
/

&pseudo
  izatom(1) = 6
  file_pseudo(1) = './06-C.LDA.fhi'
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 32, 32, 32
/

&kgrid
  num_kgrid = 6, 6, 6
/

&tgrid
  dt = 7.8d-5
  nt = 641100
/

&emfield
  ! impulsive field along z
  ae_shape1 = 'impulse'
  epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
/

&analysis
  ! energy grid of the response output: 3000 points of 0.01 eV (30 eV)
  de      = 0.01d0
  nenergy = 3000
  ! Not in the executed run (default 'n'). Removes the window-weighted mean of the current before the
  ! transform; checked offline only in this tutorial. Acts only for yn_periodic = 'y' and fixed occupations.
  ! yn_lr_w0_correction = 'y'
/

&atomic_red_coor
  'C' 0.05d0 0.05d0 0.05d0 1
  'C' 0.30d0 0.30d0 0.30d0 1
/

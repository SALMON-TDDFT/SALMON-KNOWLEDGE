! Diamond linear response from an impulse (theory = 'tddft_response'), SALMON v2.3.0: one rung of the k ladder.
! Primitive 2-atom fcc cell, FHI98PP LDA, xc = 'PZ', nstate = 8, 20^3 grid, 20^3 k mesh (the ground-state mesh).
! dt = 2.0e-4 fs = 75 % of the estimated stability limit of the 4th-order Taylor propagator at this grid
! (2.66e-4 fs); nt = 250000 -> 50.0 fs. Based on the official sample exercise_05_bulkSi_lr.
! The other rungs of the k ladder differ only in num_kgrid, nproc_k and the node count; the rungs of the
! r ladder (k 6^3) differ in num_rgrid, num_kgrid, dt and nt (see the tutorial).
! Run in a directory that holds ./06-C.LDA.fhi and ./restart/ . ./restart/ must contain info.bin,
! occupation.bin, rho_inout.bin and wfn.bin of the matching ground-state run (20^3 grid, 20^3 k mesh,
! nstate = 8; the ground-state deck of this tutorial with num_rgrid and num_kgrid changed), copied or linked
! from that run's data_for_restart/. The executed run read the ground state through a relative path to the
! neighboring run directory; use a short relative path (SALMON stores it in a 100-character string, so a
! long absolute path is truncated).
&calculation
  theory = 'tddft_response'
/

&control
  sysname = 'diamond_lr_r20k20'
  yn_restart = 'n'
  directory_read_data = './restart/'
/

&parallel
  process_allocation = 'orbital_sequential'
  ! 200 nodes x 4 MPI processes = 800 (10 k points per process); nproc_k must divide the number of k points (8000)
  nproc_k  = 800
  nproc_ob = 1
  nproc_rgrid = 1, 1, 1
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al_vec1 = 0.0d0, 1.7835d0, 1.7835d0
  al_vec2 = 1.7835d0, 0.0d0, 1.7835d0
  al_vec3 = 1.7835d0, 1.7835d0, 0.0d0
  nstate = 8
  nelec  = 8
  nelem  = 1
  natom  = 2
  yn_symmetry = 'n'
/

&pseudo
  izatom(1) = 6
  file_pseudo(1) = './06-C.LDA.fhi'
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 20, 20, 20
/

&kgrid
  num_kgrid = 20, 20, 20
/

&tgrid
  dt = 2.0d-4
  nt = 250000
/

&emfield
  ! impulsive field along z
  ae_shape1 = 'impulse'
  epdir_re1(1:3) = 0.0d0, 0.0d0, 1.0d0
/

&analysis
  ! energy grid of the response output: 3000 points of 0.01 eV (30 eV). SALMON's own spectrum is undamped;
  ! the damped spectra of the tutorial are rebuilt from Jm_z in *_rt.data (scripts/rebuild_damped_spectrum.py).
  de      = 0.01d0
  nenergy = 3000
/

&atomic_red_coor
  'C' 0.05d0 0.05d0 0.05d0 1
  'C' 0.30d0 0.30d0 0.30d0 1
/

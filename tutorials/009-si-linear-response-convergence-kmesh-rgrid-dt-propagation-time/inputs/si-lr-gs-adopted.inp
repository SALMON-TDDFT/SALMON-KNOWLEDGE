! Si 8-atom cubic cell, ground state that feeds the linear-response run (SALMON v2.3.0).
! Adopted point (maintainer's judgment): num_rgrid = 20^3, num_kgrid = 16^3, nstate = 32.
! This is the k16 rung of the k ladder, so this ground state was run; r24 and finer are the safe zone.
! Based on the official sample exercise_04_bulkSi_gs. Differences from it: FHI98PP LDA
! pseudopotential, r / k / nstate, explicit &parallel.
! Run in a directory that holds ./14-Si.LDA.fhi (ABINIT LDA_FHI 14-Si.LDA.fhi).
! nstate = 32 (16 occupied + 16 empty bands) on purpose: with nstate = 16 (occupied bands only)
! the SCF stalls (see SALMON-TS-007). The linear-response result does not depend on nstate.
! write_gs_restart_data keeps its default ('all'): the response run reads data_for_restart/ of this run.
&calculation
  theory = 'dft'
/

&parallel
  ! 8 nodes x 4 MPI processes = 32; nproc_k must divide the number of k-points (4096)
  nproc_k = 32
  nproc_ob = 1
  nproc_rgrid(1:3) = 1, 1, 1
/

&control
  sysname = 'si_gs_r20k16'
  yn_restart = 'n'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al(1:3) = 5.43d0, 5.43d0, 5.43d0
  nelem  = 1
  natom  = 8
  nelec  = 32
  nstate = 32
/

&pseudo
  file_pseudo(1) = './14-Si.LDA.fhi'
  izatom(1) = 14
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 20, 20, 20
/

&kgrid
  ! shifted Monkhorst-Pack mesh (SALMON default); the response run must use the same mesh
  num_kgrid(1:3) = 16, 16, 16
/

&scf
  nscf      = 300
  threshold = 1.0d-9
/

&atomic_red_coor
  'Si'	.0	.0	.0	1
  'Si'	.25	.25	.25	1
  'Si'	.5	.0	.5	1
  'Si'	.0	.5	.5	1
  'Si'	.5	.5	.0	1
  'Si'	.75	.25	.75	1
  'Si'	.25	.75	.75	1
  'Si'	.75	.75	.25	1
/

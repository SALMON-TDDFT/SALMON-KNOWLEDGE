! Si 8-atom cubic cell, linear response from an impulse (theory = 'tddft_response'), SALMON v2.3.0.
! Adopted point (maintainer's judgment): num_rgrid = 20^3, num_kgrid = 16^3 (same mesh as the ground state),
! nstate = 32, dt = 0.0005 fs, nt = 24000 (T = 12 fs), polarization along z. This is the k16 rung of the
! k ladder, so this response was run.
! Based on the official sample exercise_05_bulkSi_lr. Differences from it: FHI98PP LDA
! pseudopotential, r / k / nstate / dt / nt, and explicit &parallel.
! Run in a directory that holds ./14-Si.LDA.fhi and ./restart/ . ./restart/ must contain info.bin,
! occupation.bin and wfn.bin of the matching ground-state run (same r, k, nstate), copied or linked
! from that run's data_for_restart/. wfn.bin is only read.
&calculation
  theory = 'tddft_response'
/

&parallel
  ! 16 nodes x 4 MPI processes = 64; nproc_k must divide the number of k-points (4096)
  nproc_k = 64
  nproc_ob = 1
  nproc_rgrid(1:3) = 1, 1, 1
/

&control
  sysname = 'si_lr_r20k16'
  yn_restart = 'n'
  directory_read_data = './restart/'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  yn_periodic = 'y'
  al(1:3) = 5.43d0, 5.43d0, 5.43d0
  nelem  = 1
  natom  = 8
  nelec  = 32
  nstate = 32
/

&pseudo
  file_pseudo(1) = './14-Si.LDA.fhi'
  izatom(1) = 14
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid(1:3) = 20, 20, 20
/

&kgrid
  num_kgrid(1:3) = 16, 16, 16
/

&tgrid
  dt = 0.0005d0
  nt = 24000
/

&emfield
  ae_shape1 = 'impulse'
  epdir_re1(1:3) = 0.00d0, 0.00d0, 1.00d0
/

&analysis
  de      = 0.01d0
  nenergy = 2000
  ! yn_lr_w0_correction is left at its default 'n', as in every run of the tutorial. Set it to 'y'
  ! only if Im eps below about 2*pi*hbar/T (0.35 eV at 12 fs) is read: it removes the spurious
  ! 1/omega rise there (verified offline only; acts for yn_periodic = 'y' and fixed occupations).
/

&atomic_red_coor
  'Si'	.0	.0	.0	1
  'Si'	.25	.25	.25	1
  'Si'	.5	.0	.5	1
  'Si'	.0	.5	.5	1
  'Si'	.5	.5	.0	1
  'Si'	.75	.25	.75	1
  'Si'	.25	.75	.75	1
  'Si'	.75	.75	.25	1
/

/
&system
  yn_periodic = 'y'
  al = 5.430400000000, 5.430400000000, 5.430400000000
  nelem = 1
  natom = 8
  nelec = 32
  nstate = 32
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = '../downloads/Si.upf'
/

&functional
